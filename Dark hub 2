-- ============================================
-- FUNÇÕES AUXILIARES
-- ============================================
local function getChar()
    local char = player.Character
    if not char then return nil end
    return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

local function teleportar(pos, speed)
    local _, _, hrp = getChar()
    if not hrp then return false end
    local dist = (hrp.Position - pos).Magnitude
    if dist < 5 then return true end
    local tempo = math.clamp(dist / (speed or 350), 0.15, 1.2)
    local tw = TweenService:Create(hrp, TweenInfo.new(tempo, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    tw:Play()
    pcall(function() tw.Completed:Wait() end)
    return true
end

local function acharMob(nomeMob)
    local _, _, hrp = getChar()
    if not hrp or not nomeMob then return nil end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    local alvo, menorDist = nil, math.huge
    local busca = string.lower(nomeMob)
    for _, mob in ipairs(enemies:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mhrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
        if hum and hum.Health > 0 and mhrp then
            local nome = string.lower(mob.Name)
            if nome:find(busca, 1, true) or busca:find(nome, 1, true) then
                local d = (hrp.Position - mhrp.Position).Magnitude
                if d < menorDist then
                    menorDist = d
                    alvo = mob
                end
            end
        end
    end
    return alvo
end

-- ============================================
-- AUTO FARM (Fast Attack incluso)
-- ============================================
local function atacar(mob)
    local char, hum, hrp = getChar()
    if not hrp or not mob then return end
    local mhrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
    if not mhrp then return end

    -- Fica um pouco acima do NPC
    teleportar(mhrp.Position + Vector3.new(0, farmPosY, 0))

    -- Auto Haki
    if autoHakiAtivo then
        if not char:FindFirstChild("HasBuso") then
            pcall(function() CommF_:InvokeServer("Buso") end)
        end
    end

    -- Fast Attack (RegisterHit) - Muito mais rápido que tool:Activate()
    pcall(function()
        local attackRemote = Net:WaitForChild("RE/RegisterAttack")
        local hitRemote = Net:WaitForChild("RE/RegisterHit")
        if attackRemote and hitRemote then
            attackRemote:FireServer(0.1)
            hitRemote:FireServer(mhrp, {}, nil, tostring(math.random(100000,999999)))
        end
    end)

    -- Ativa V3 se estiver ligado
    if autoV3 and char:FindFirstChild("RaceTransformed") and not char.RaceTransformed.Value then
        pcall(function() CommE:FireServer("ActivateAbility") end)
    end

    -- Ativa V4 se estiver ligado (Barra cheia)
    if autoV4 and char:FindFirstChild("RaceEnergy") and char:FindFirstChild("RaceTransformed") then
        if char.RaceEnergy.Value >= 1 and not char.RaceTransformed.Value then
            pcall(function()
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
                -- Tenta ativar pela tecla Y também
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton1(Vector2.new(0,0))
            end)
        end
    end

    -- Bring Mob (Puxa o mob pra você)
    if bringAtivo then
        pcall(function()
            if CommE then CommE:FireServer("Bring", mob) end
        end)
    end
end

local function loopFarm()
    while autoFarmAtivo do
        pcall(function()
            local char, hum, hrp = getChar()
            if not char or not hum or not hrp then return end

            local questMob = nil
            local level = player.Data.Level.Value

            -- Pega o mob da quest ativa (se tiver)
            local questGui = player.PlayerGui:FindFirstChild("Main") and player.PlayerGui.Main:FindFirstChild("Quest")
            if questGui and questGui.Visible then
                local container = questGui:FindFirstChild("Container")
                local title = container and container:FindFirstChild("QuestTitle")
                local t = title and title:FindFirstChild("Title")
                if t and t.Text and t.Text ~= "" then
                    questMob = t.Text:match("Defeat%s+%d+%s+(.-)%s+%(")
                end
            end

            -- Se não achou quest e o modo for Level, pega uma nova
            if not questMob and farmMode == "Level" and takeQuest then
                -- Tenta pegar quest baseado no level (simplificado)
                -- (Idealmente usar GuideModule, mas para simplificar vamos pular)
            end

            -- Se achou mob, ataca
            if questMob then
                local mob = acharMob(questMob)
                if mob then
                    atacar(mob)
                end
            else
                -- Se não tem quest, ataca qualquer mob próximo (fallback)
                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    for _, mob in ipairs(enemies:GetChildren()) do
                        local mhrp = mob:FindFirstChild("HumanoidRootPart")
                        if mhrp and (hrp.Position - mhrp.Position).Magnitude < 500 then
                            atacar(mob)
                            break
                        end
                    end
                end
            end
        end)
        task.wait(attackDelay)
    end
end

local function ligarFarm()
    if autoFarmAtivo then return end
    autoFarmAtivo = true
    farmThread = task.spawn(loopFarm)
end

local function desligarFarm()
    autoFarmAtivo = false
    if farmThread then
        pcall(function() task.cancel(farmThread) end)
        farmThread = nil
    end
end

