local espAtivo = false
local espConexoes = {}

local function limparESP()
    for _, conn in ipairs(espConexoes) do
        pcall(function() conn:Disconnect() end)
    end
    espConexoes = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:FindFirstChild("DarkESP") then
            obj.DarkESP:Destroy()
        end
    end
end

local function criarESP(obj, cor, nome)
    if not obj or not obj:IsA("BasePart") then return end
    if obj:FindFirstChild("DarkESP") then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DarkESP"
    billboard.Adornee = obj
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = obj
    
    local texto = Instance.new("TextLabel")
    texto.Size = UDim2.new(1, 0, 1, 0)
    texto.BackgroundTransparency = 1
    texto.TextColor3 = cor or Color3.fromRGB(255, 255, 255)
    texto.TextStrokeTransparency = 0.5
    texto.TextSize = 14
    texto.Font = Enum.Font.GothamBold
    texto.Text = nome or "Objeto"
    texto.Parent = billboard
    
    -- Atualiza a distância em tempo real
    local conn = RunService.Heartbeat:Connect(function()
        if not obj or not obj.Parent then
            billboard:Destroy()
            return
        end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dist = (obj.Position - hrp.Position).Magnitude
            texto.Text = string.format("%s\n[%d studs]", nome or obj.Name, math.floor(dist))
        end
    end)
    table.insert(espConexoes, conn)
end

