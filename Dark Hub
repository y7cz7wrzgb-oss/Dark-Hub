-- ============================================
-- LÓGICA DE AUTO FARM (Blox Fruits)
-- ============================================
local autoFarmAtivo = false
local farmThread = nil

-- Função: pega o CommF_ (remote principal do Blox Fruits)
local function getCommF()
    local remotes = RS:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("CommF_")
end

-- Função: teleporta o personagem até uma posição (tween suave)
local function teleportarPara(posicao)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local TweenService = game:GetService("TweenService")
    local dist = (hrp.Position - posicao).Magnitude
    local tempo = math.clamp(dist / 500, 0.1, 1.5)
    local tween = TweenService:Create(hrp, TweenInfo.new(tempo, Enum.EasingStyle.Linear), {CFrame = CFrame.new(posicao)})
    tween:Play()
    tween.Completed:Wait()
end

-- Função: procura o inimigo mais próximo do nível do jogador
local function acharInimigo()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local inimigos = workspace:FindFirstChild("Enemies")
    if not inimigos then return nil end

    local maisProximo, menorDist = nil, math.huge
    for _, inimigo in ipairs(inimigos:GetChildren()) do
        local hum = inimigo:FindFirstChild("Humanoid")
        local iHrp = inimigo:FindFirstChild("HumanoidRootPart")
        if hum and iHrp and hum.Health > 0 then
            local d = (hrp.Position - iHrp.Position).Magnitude
            if d < menorDist then
                menorDist = d
                maisProximo = inimigo
            end
        end
    end
    return maisProximo
end

local function rodarFarm()
    while autoFarmAtivo do
        pcall(function()
            local commF = getCommF()
            local alvo = acharInimigo()

            if alvo then
                local iHrp = alvo:FindFirstChild("HumanoidRootPart")
                local hum = alvo:FindFirstChild("Humanoid")
                if iHrp and hum and hum.Health > 0 then
                    -- Teleporta perto do inimigo
                    teleportarPara(iHrp.Position + Vector3.new(0, 5, 0))
                    -- Ataca
                    if commF then
                        pcall(function()
                            commF:InvokeServer("CommF_", "Attack")
                        end)
                    end
                    -- Tenta usar a arma equipada
                    local char = player.Character
                    if char then
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end
                end
            end
        end)
        task.wait(0.3)
    end
end

local function ligarFarm()
    autoFarmAtivo = true
    btnFarm.Text = "Auto Farm: ON"
    btnFarm.BackgroundColor3 = Color3.fromRGB(30, 130, 60)
    status.Text = "Status: Farmando..."
    status.TextColor3 = Color3.fromRGB(80, 220, 120)
    farmThread = task.spawn(rodarFarm)
end

local function desligarFarm()
    autoFarmAtivo = false
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
    btnFarm.Text = "Auto Farm: OFF"
    btnFarm.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    status.Text = "Status: Parado"
    status.TextColor3 = Color3.fromRGB(160, 160, 160)
end

