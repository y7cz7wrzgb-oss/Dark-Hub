local function getChar()
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return char, hum, hrp
end

local function teleportar(pos)
    local _, _, hrp = getChar()
    if not hrp then return false end
    local dist = (hrp.Position - pos).Magnitude
    if dist < 5 then return true end
    local tempo = math.clamp(dist / 350, 0.15, 1.2)
    local tw = TweenService:Create(hrp, TweenInfo.new(tempo, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
    tw:Play()
    pcall(function() tw.Completed:Wait() end)
    return true
end

-- Acha NPC por nome aproximado (procura em workspace e ReplicatedStorage.NPCs)
local function acharNPC(nomeBusca)
    if not nomeBusca then return nil end
    nomeBusca = string.lower(nomeBusca)

    local function procurarEm(container)
        if not container then return nil end
        for _, obj in ipairs(container:GetChildren()) do
            local nome = string.lower(obj.Name)
            if nome:find(nomeBusca, 1, true) or nomeBusca:find(nome, 1, true) then
                local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if hrp then return hrp.CFrame end
                if obj:IsA("BasePart") then return obj.CFrame end
            end
        end
        return nil
    end

    -- 1) procura nos NPCs do jogo
    local npcs = workspace:FindFirstChild("NPCs") or RS:FindFirstChild("NPCs")
    local c = procurarEm(npcs)
    if c then return c end

    -- 2) procura via GuideModule NPCList
    if GuideModule and GuideModule.Data and GuideModule.Data.NPCList then
        for _, npc in pairs(GuideModule.Data.NPCList) do
            if npc.InternalQuestName and string.lower(npc.InternalQuestName):find(nomeBusca, 1, true) then
                local nomeNPC = npc.NPCName or npc.InternalQuestName
                local c2 = procurarEm(npcs)
                if c2 then return c2 end
            end
        end
    end

    return nil
end

-- Acha o mob mais próximo
local function acharMob(nomeMob)
    local _, _, hrp = getChar()
    if not hrp or not nomeMob then return nil end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local alvo, menorDist = nil, math.huge
    for _, mob in ipairs(enemies:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mhrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
        if hum and hum.Health > 0 and mhrp then
            if mob.Name:lower():find(nomeMob:lower(), 1, true) or nomeMob:lower():find(mob.Name:lower(), 1, true) then
                local d = (hrp.Position - mhrp.Position).Magnitude
                if d < menorDist then
                    menorDist = d
                    alvo = mob
                end
            end
        end
    end
    return alvo
end

-- Pega a quest atual via GuideModule
local function getQuestAtual()
    local level = player.Data.Level.Value

    -- 1) Se já tem quest ativa, descobre o mob dela
    local questGui = player.PlayerGui:FindFirstChild("Main") and player.PlayerGui.Main:FindFirstChild("Quest")
    if questGui and questGui.Visible then
        local container = questGui:FindFirstChild("Container")
        local title = container and container:FindFirstChild("QuestTitle")
        local t = title and title:FindFirstChild("Title")
        if t and t.Text and t.Text ~= "" then
            local match = t.Text:match("Defeat%s+%d+%s+(.-)%s+%(")
            if match then
                return { mob = match, quest = "ativa", level = level }
            end
        end
    end

    -- 2) Senão, procura no GuideModule qual a próxima quest
    if GuideModule and GuideModule.Data and GuideModule.Data.NPCList then
        local melhor = nil
        for _, npc in pairs(GuideModule.Data.NPCList) do
            if npc.Levels and table.find(npc.Levels, level) then
                melhor = npc
                break
            end
        end
        if melhor then
            local mob = melhor.InternalQuestName or melhor.NPCName
            return { mob = mob, quest = melhor.InternalQuestName, level = level }
        end
    end

    return { mob = nil, quest = nil, level = level }
end

-- Ativa Haki
local function autoHaki()
    if not autoHakiAtivo then return end
    local char = player.Character
    if not char then return end
    if not char:FindFirstChild("HasBuso") then
        pcall(function()
            CommF_:InvokeServer("Buso")
        end)
    end
end

-- Ataca o mob
local function atacar(mob)
    local char, hum, hrp = getChar()
    if not hrp or not mob then return end
    local mhrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
    if not mhrp then return end

    -- Fica em cima do mob
    local destino = mhrp.Position + Vector3.new(0, farmPosY, 0)
    teleportar(destino)

    -- Ativa Haki
    autoHaki()

    -- Tenta atacar com RegisterHit / tool
    pcall(function()
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)

    -- Bring mob (puxa o mob pra você)
    if bringAtivo then
        pcall(function()
            local bringRemote = Remotes:FindFirstChild("CommE")
            if bringRemote then
                bringRemote:FireServer("Bring", mob)
            end
        end)
    end
end

-- ============================================
-- LOOP DO AUTOFARM
-- ============================================
local function loopFarm()
    while autoFarmAtivo do
        local ok, err = pcall(function()
            local char, hum, hrp = getChar()
            if not char or not hum or not hrp then return end

            local q = getQuestAtual()
            questAtual = q

            -- Se não temos mob, tenta pegar quest
            if not q.mob then
                task.wait(0.5)
                return
            end

            -- Procura o mob
            local mob = acharMob(q.mob)
            if mob then
                atacar(mob)
            else
                -- Mob não encontrado, tenta ir pro NPC da quest
                local c = acharNPC(q.quest)
                if c then
                    teleportar(c.Position + Vector3.new(0, 5, 0))
                end
            end
        end)

        task.wait(attackDelay)
    end
end

local function ligarFarm()
    if autoFarmAtivo then return end
    autoFarmAtivo = true
    farmThread = task.spawn(loopFarm)
end

local function desligarFarm()
    autoFarmAtivo = false
    if farmThread then
        pcall(function() task.cancel(farmThread) end)
        farmThread = nil
    end
end

