local arrastandoBtn, startBtn, startPosBtn = false, nil, nil

botaoD.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastandoBtn = true
        startBtn = input.Position
        startPosBtn = botaoD.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if arrastandoBtn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - startBtn
        botaoD.Position = UDim2.new(
            startPosBtn.X.Scale, startPosBtn.X.Offset + delta.X,
            startPosBtn.Y.Scale, startPosBtn.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastandoBtn = false
    end
end)

